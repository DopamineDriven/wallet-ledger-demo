{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/**/*.ts",
        "tsdown.config.ts",
        "tsconfig.json",
        "package.json",
        "eslint.config.ts"
      ]
    }
  }
}
