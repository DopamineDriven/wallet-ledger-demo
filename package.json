{
  "name": "@wallet-ledger/root",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@10.28.2+sha512.41872f037ad22f7348e3b1debbaf7e867cfd448f2726d9cf74c08f19507c31d2c8e7a11525b983febc2df640b5438dee6023ebb1f84ed43cc2d654d2bc326264",
  "scripts": {
    "env:seed": "bash ./populate-env.sh",
    "build:db": "turbo build --filter=@wallet-ledger/db",
    "build:seed": "turbo build --filter=@wallet-ledger/seed",
    "build:targeted": "pnpm build:db && pnpm:build:types && pnpm build:seed && pnpm build:ui && pnpm build:wallet",
    "build:types": "turbo build --filter=@wallet-ledger/types",
    "build:ui": "turbo build --filter=@wallet-ledger/ui",
    "build:wallet": "turbo build --filter=@wallet-ledger/wallet",
    "build:web": "turbo build --filter=@wallet-ledger/web",
    "clean": "git clean -xdf node_modules",
    "dev": "turbo dev --parallel --continue",
    "format": "prettier --write \"**/*.{ts,tsx,cts,mts,js,jsx,mjs,cjs,json,yaml,yml,css,html,md,mdx}\" --ignore-unknown --cache",
    "lint": "turbo lint",
    "prepare": "husky",
    "typecheck": "turbo typecheck",
    "stress:test:new": "bash ./new-user-stress-test.sh",
    "stress:test:api": "bash ./stress-test-api.sh",
    "clean:house": "bash ./manage.sh clean:house",
    "generate:base64": "openssl rand -base64 64",
    "generate:hex": "openssl rand -hex 64",
    "list:packages": "bash ./manage.sh list",
    "postclean:house": "pnpm --filter @wallet-ledger/web typegen",
    "run:seed": "pnpm --filter @wallet-ledger/seed gen",
    "run:wallet": "turbo dev --filter=@wallet-ledger/wallet",
    "run:web": "turbo dev --filter=@wallet-ledger/web",
    "test:wallet": "cd apps/wallet && pnpm test"
  },
  "devDependencies": {
    "@wallet-ledger/eslint-config": "workspace:*",
    "@wallet-ledger/prettier-config": "workspace:*",
    "@wallet-ledger/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo7",
    "dotenv": "catalog:dotenv",
    "eslint": "catalog:eslint",
    "husky": "catalog:husky",
    "prettier": "catalog:prettier",
    "tsx": "catalog:tsx",
    "turbo": "catalog:turbo",
    "typescript": "catalog:ts"
  },
  "prettier": "@wallet-ledger/prettier-config",
  "engines": {
    "node": ">=24",
    "npm": ">=10",
    "pnpm": ">=9"
  }
}
