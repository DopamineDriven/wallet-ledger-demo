{
  "name": "@wallet-ledger/seed",
  "version": "1.0.0",
  "description": "convenient seeding helpers",
  "publishConfig": {
    "access": "public",
    "typesVersions": {
      "*": {
        "*": [
          "dist/index.d.ts"
        ],
        "items": [
          "dist/items/index.d.ts"
        ],
        "utils": [
          "dist/seed.d.ts"
        ],
        "types": [
          "dist/types.d.ts"
        ]
      }
    }
  },
  "license": "MIT",
  "source": "src/index.ts",
  "typesVersions": {
    "*": {
      "*": [
        "dist/index.d.ts"
      ],
      "items": [
        "dist/items/index.d.ts"
      ],
      "utils": [
        "dist/utils.d.ts"
      ],
      "types": [
        "dist/types.d.ts"
      ]
    }
  },
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist/**/*.{js,cjs,mjs,d.ts,d.cts,d.mts}"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./items": "./dist/items/index.js",
    "./utils": "./dist/utils.js",
    "./types": "./dist/types.js"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "pnpm build",
    "lint": "eslint",
    "format": "prettier --write \"src/**/*.{ts,cts,mts,js,mjs,cjs,json,yaml,yml}\" --ignore-unknown --cache",
    "clean": "git clean -xdf .turbo dist node_modules",
    "gen": "pnpm gen:items",
    "gen:items": "tsx src/test/index.ts --probe init --path \"products\" --gen \"items\""
  },
  "dependencies": {
    "@d0paminedriven/fs": "catalog:ddfs",
    "@wallet-ledger/types": "workspace:*"
  },
  "devDependencies": {
    "@wallet-ledger/db": "workspace:*",
    "@wallet-ledger/eslint-config": "workspace:*",
    "@wallet-ledger/prettier-config": "workspace:*",
    "@wallet-ledger/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo7",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "prettier": "catalog:prettier",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@wallet-ledger/prettier-config"
}
