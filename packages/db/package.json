{
  "name": "@wallet-ledger/db",
  "version": "1.0.0",
  "description": "convenient db helpers",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "lint": "eslint",
    "format": "prisma format",
    "clean": "git clean -xdf .turbo dist node_modules",
    "prebuild": "rm -rf dist/ && pnpm db:generate",
    "predev": "pnpm db:generate",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio --browser none --port 7777"
  },
  "files": [
    "dist/**",
    "prisma/**",
    "package.json"
  ],
  "exports": {
    "./factory": {
      "types": "./dist/factory.d.ts",
      "import": "./dist/factory.js",
      "default": "./dist/factory.js"
    },
    "./node": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "default": "./dist/db.js"
    },
    "./db-accelerate": {
      "types": "./dist/db-accelerate.d.ts",
      "import": "./dist/db-accelerate.js",
      "default": "./dist/db-accelerate.js"
    },
    "./node/generated/client": {
      "types": "./dist/client-node.d.ts",
      "import": "./dist/client-node.js",
      "default": "./dist/client-node.js"
    },
    "./node/generated/models": {
      "types": "./dist/models-node.d.ts",
      "import": "./dist/models-node.js",
      "default": "./dist/models-node.js"
    },
    "./enums-node": {
      "types": "./dist/enums-node.d.ts",
      "import": "./dist/enums-node.js",
      "default": "./dist/enums-node.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "catalog:prisma",
    "@prisma/client": "catalog:prisma",
    "@prisma/client-runtime-utils": "catalog:prisma",
    "@prisma/extension-accelerate": "catalog:prisma",
    "dotenv": "catalog:dotenv"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "catalog:ddfs",
    "@types/node": "catalog:node",
    "@types/pg": "catalog:pg",
    "@typescript/native-preview": "catalog:tsgo7",
    "@wallet-ledger/eslint-config": "workspace:*",
    "@wallet-ledger/prettier-config": "workspace:*",
    "@wallet-ledger/tsconfig": "workspace:*",
    "eslint": "catalog:eslint",
    "jiti": "catalog:jiti",
    "pg": "catalog:pg",
    "prettier": "catalog:prettier",
    "prisma": "catalog:prisma",
    "rolldown": "catalog:rolldown",
    "rolldown-plugin-dts": "catalog:rolldown",
    "tsdown": "catalog:tsdown",
    "tslib": "catalog:tslib",
    "tsx": "catalog:tsx",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@wallet-ledger/prettier-config"
}
