{
  "name": "@wallet-ledger/db",
  "version": "1.0.0",
  "description": "convenient db helpers",
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown",
    "lint": "eslint",
    "format": "prisma format",
    "clean": "git clean -xdf .turbo dist node_modules",
    "v:postbuild": "pnpm cp:binaries",
    "prebuild": "rm -rf dist/ && pnpm db:generate",
    "predev": "pnpm db:generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio --browser none --port 7777",
    "precp:binaries": "tsx src/test/scan-output.ts --scan output",
    "cp:binaries": "cp -r ./src/generated/prisma/*.x.so.node ./dist/generated/prisma"
  },
  "files": [
    "dist/**",
    "prisma/**",
    "package.json"
  ],
  "exports": {
    "./node": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js",
      "default": "./dist/db.js"
    },
    "./node/generated/client": {
      "types": "./dist/client-node.d.ts",
      "import": "./dist/client-node.js",
      "default": "./dist/client-node.js"
    },
    "./node/generated/models": {
      "types": "./dist/models-node.d.ts",
      "import": "./dist/models-node.js",
      "default": "./dist/models-node.js"
    },
    "./enums-node": {
      "types": "./dist/enums-node.d.ts",
      "import": "./dist/enums-node.js",
      "default": "./dist/enums-node.js"
    }
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "jiti": "^2.6.1"
  },
  "devDependencies": {
    "@d0paminedriven/fs": "^11.0.0",
    "@wallet-ledger/eslint-config": "workspace:*",
    "@wallet-ledger/prettier-config": "workspace:*",
    "@wallet-ledger/tsconfig": "workspace:*",
    "@types/node": "catalog:node",
    "@typescript/native-preview": "catalog:tsgo7",
    "dotenv": "^17.2.3",
    "eslint": "catalog:eslint",
    "prettier": "catalog:prettier",
    "prisma": "^7.3.0",
    "rolldown": "^1.0.0-rc.1",
    "rolldown-plugin-dts": "^0.21.6",
    "tsdown": "catalog:tsdown",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "catalog:ts",
    "typescript-eslint": "catalog:tseslint"
  },
  "prettier": "@wallet-ledger/prettier-config"
}
